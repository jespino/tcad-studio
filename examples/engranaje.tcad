// Engranaje sencillo de dientes rectos con eje hexagonal.
param dientes = 18  // [6:1:40] Número de dientes
param radio   = 20  // [10:50] Radio del cuerpo (mm)
param grosor  = 6   // [2:20] Grosor (mm)
param eje     = 4   // [2:0.5:8] Radio del hexágono del eje

let $sides = 64
let alto_diente = 3.5
let ancho_diente = 2 * PI * radio / dientes / 2

group {
  cylinder(radius=radio, height=grosor)
  for i in range(dientes) {
    // Cada diente es un trapecio extruido, colocado en el borde y girado.
    extrude(points=[[-ancho_diente/2, 0], [ancho_diente/2, 0],
                    [ancho_diente/4, alto_diente], [-ancho_diente/4, alto_diente]],
            height=grosor)
      .move(y=radio - 0.5)
      .rotate(z=i * 360 / dientes)
  }
  // Aligeramientos
  for i in range(5) {
    hole cylinder(radius=4, height=grosor + 2).move(x=radio * 0.55, z=-1).rotate(z=i * 72)
  }
  hole polygon(sides=6, radius=eje, height=grosor + 2).move(z=-1)
  // Refuerzo alrededor del eje
  tube(radius=eje + 3, wall=2, height=grosor + 1)
}
