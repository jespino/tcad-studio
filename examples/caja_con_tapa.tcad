// Caja con tapa encajable. Las dos piezas se imprimen una al lado de la otra.
param largo   = 60   // [30:150] Largo exterior, eje X (mm)
param ancho   = 40   // [30:150] Ancho exterior, eje Y (mm)
param alto    = 30   // [10:100] Altura de la caja sin tapa (mm)
param pared   = 2    // [1.2:0.2:4] Grosor de pared (mm)
param holgura = 0.3  // [0:0.05:0.8] Juego entre la pestaña de la tapa y la caja (mm)

let $sides = 48
let radio = 3
let interior_l = largo - 2*pared
let interior_a = ancho - 2*pared

// Caja: sólido redondeado menos el interior.
group {
  box(largo, ancho, alto, radius=radio)
  hole box(interior_l, interior_a, alto, radius=1).move(z=pared)
}

// Tapa: placa + pestaña hueca que entra en la boca de la caja.
// El texto va grabado en la cara de abajo, en espejo, para leerse bien
// cuando se le da la vuelta a la tapa.
group {
  box(largo, ancho, pared, radius=1)
  box(interior_l - 2*holgura, interior_a - 2*holgura, pared + 4, radius=1)
  hole box(interior_l - 2*holgura - 2*pared, interior_a - 2*holgura - 2*pared, 10).move(z=pared)
  hole text("TCAD", size=10, height=1, font="sans-bold").mirror("x").move(z=-0.5)
}.move(y=ancho + 10).color("blue")
