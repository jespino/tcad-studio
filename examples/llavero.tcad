// Llavero con nombre en relieve.
param nombre = "Jesus"  // Texto del llavero
param grosor = 3        // [2:0.5:6] Grosor de la placa (mm)
param fuente = "sans-bold" in ["sans", "sans-bold", "sans-italic", "sans-bold-italic", "mono", "mono-bold"]  // Tipo de letra

let largo = len(nombre) * 7 + 16

group {
  box(largo, 16, grosor, radius=1, steps=4)
  // anilla
  hole cylinder(radius=2.5, height=10).move(x=-largo/2 + 5, z=-1)
}
// El texto se hunde 0.5 mm en la placa para una unión sólida; sobresale 1.5 mm.
text(nombre, size=8, height=2, font=fuente).move(x=4, y=-0.5, z=grosor - 0.5).color("white")
