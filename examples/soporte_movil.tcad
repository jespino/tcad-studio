// Soporte para móvil: base, respaldo inclinado con refuerzos y tope delantero.
// El móvil mira hacia -Y y se apoya en el respaldo, que se inclina hacia +Y.
param ancho      = 70   // [40:120] Ancho del soporte, eje X (mm)
param angulo     = 65   // [45:85] Inclinación del respaldo respecto a la horizontal (°)
param grosor_mov = 11   // [6:0.5:20] Grosor del teléfono con funda (mm)

let fondo     = 80      // eje Y
let g         = 5       // grosor de las placas
let alto_resp = 90
let y0        = -fondo/2 + grosor_mov + 12  // arista delantera del respaldo

// Longitud horizontal del refuerzo y la altura que le corresponde
let l_ref = 25
let h_ref = l_ref * tan(angulo)

group {
  // Base
  box(ancho, fondo, g, radius=1)

  // Respaldo: placa con la arista inferior delantera en el origen,
  // girada sobre el eje X y colocada encima de la base.
  box(ancho, g, alto_resp, radius=1)
    .move(y=g/2)
    .rotate(x=-(90 - angulo))
    .move(y=y0, z=g)

  // Refuerzos traseros: cuñas con la pendiente igual al respaldo.
  // wedge tiene la cara vertical en -X; al girar -90° en Z pasa a +Y.
  for x in [-ancho/3, ancho/3] {
    wedge(l_ref, 6, h_ref)
      .rotate(z=-90)
      .move(x=x, y=y0 + g / sin(angulo) + l_ref/2 - 1, z=g)
  }

  // Tope delantero
  box(ancho, 4, 10, radius=1).move(y=y0 - grosor_mov - 2, z=g - 1)

  // Paso para el cable a través del tope y la parte baja del respaldo
  hole box(14, 2*grosor_mov + 20, 20, radius=2).move(y=y0, z=g)
}
