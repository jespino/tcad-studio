# Build output
/bin/
/out/
/.task/

# The user's own designs (not part of the project)
/designs/

# Generated meshes and previews
*.stl
*.png
# ...except the documentation's images
!/docs/*.png

# TCAD Studio state written into opened folders
.tcad/

# Local Claude Code settings
.claude/settings.local.json

# Editors and OS
.idea/
.vscode/
*.swp
.DS_Store

# Agent files TCAD Studio writes when it opens examples/
/examples/AGENTS.md
/examples/CLAUDE.md
/examples/GEMINI.md
/examples/.agents/
/examples/.claude/
